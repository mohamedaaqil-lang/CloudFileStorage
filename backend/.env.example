# ====================================================================
# Cloud-Based File Storage and Sharing System - Environment Configuration
# ====================================================================

# Flask Application Settings
FLASK_ENV=development
PORT=5000
SECRET_KEY=your_super_secret_jwt_and_session_key_here_change_in_production
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://localhost:8080

# Firebase Configuration
# 1. Firebase Service Account JSON Path (Download from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key)
# Place the downloaded json file inside the backend/ directory (e.g. backend/firebase_credentials.json)
FIREBASE_SERVICE_ACCOUNT_KEY=firebase_credentials.json

# 2. Firebase Storage Bucket URL (e.g., your-project-id.appspot.com or your-project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# 3. Firebase Web API Key (For Firebase Auth REST operations from Project Settings -> General -> Web API Key)
FIREBASE_WEB_API_KEY=AIzaSyYourFirebaseWebApiKeyHere

# 4. Firebase Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local File Storage Fallback (Optional: enable true to store files locally under backend/uploads if Firebase is not yet configured)
LOCAL_FALLBACK_MODE=true
MAX_UPLOAD_SIZE_MB=50
